# ---- App ----
ENV=dev                              # dev | staging | prod
SERVICE_NAME=samvidhan-api
APP_VERSION=dev                      # git sha in Docker builds
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                   # console | json
DEBUG_UI=true
CORS_ORIGINS=http://localhost:8501   # comma-separated

# ---- Database ----
DB_HOST_PORT=5433                    # host port of the compose db (5432 is often taken)
DATABASE_URL=postgresql+asyncpg://samvidhan:samvidhan@localhost:5433/samvidhan
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_S=5
READINESS_TIMEOUT_S=2

# ---- LLM providers (secrets: never commit real values) ----
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Models (verify IDs / free-tier availability before use) ----
ROUTER_MODEL=groq/llama-3.1-8b-instant
ROUTER_FALLBACK_MODEL=gemini/<current-flash-lite-id>
ANSWER_MODEL=groq/llama-3.3-70b-versatile
ANSWER_FALLBACK_MODEL=gemini/<current-flash-id>
ROUTER_MODEL_LONG=groq/llama-3.3-70b-versatile
ANSWER_MODEL_LONG=gemini/<current-flash-id>
ANSWER_FALLBACK_MODEL_LONG=groq/llama-3.3-70b-versatile
SUMMARY_MODEL=groq/llama-3.1-8b-instant
JUDGE_MODEL=gemini/<current-flash-id>
JUDGE_FALLBACK_MODEL=groq/openai/gpt-oss-120b
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
MODEL_DEVICE=auto                    # auto | cpu | mps | cuda

# ---- Daily request caps per model (budget guard; set from provider console) ----
DAILY_CAP_ROUTER_MODEL=14000
DAILY_CAP_ANSWER_MODEL=1000
BUDGET_WARN_RATIO=0.8

# ---- LLM params ----
ANSWER_TEMPERATURE=0.1
ANSWER_MAX_TOKENS=700
ANSWER_MAX_TOKENS_LONG=1500
ROUTER_MAX_TOKENS=300
LLM_TIMEOUT_S=20
LLM_TIMEOUT_LONG_S=45

# ---- Prompts ----
ROUTER_PROMPT_VERSION=router.v1
ANSWER_PROMPT_VERSION=answer.v1
SUMMARY_PROMPT_VERSION=summary.v1
HYDE_PROMPT_VERSION=hyde.v1

# ---- Ingestion ----
CHUNKER_VERSION=v1

# ---- Retrieval ----
DENSE_K=20
LEXICAL_K=20
RRF_K=60
RERANK_CANDIDATES=15
RERANK_MAX_LENGTH=512
FINAL_K=5
MAX_CONTEXT_CHUNKS=8
MAX_CONTEXT_CHUNKS_LONG=15
MAX_CONTEXT_TOKENS=3000
MAX_CONTEXT_TOKENS_LONG=8000
LOW_CONFIDENCE_THRESHOLD=0.30        # tune on dev split (Phase 3)

# ---- Memory ----
ROUTER_HISTORY_MESSAGES=6
ANSWER_HISTORY_MESSAGES=2
SUMMARY_ENABLED=false
RAW_WINDOW=12
SUMMARY_BATCH=6
SESSION_TTL_DAYS=30
MAX_MESSAGES_PER_SESSION=200

# ---- Limits ----
MAX_MESSAGE_CHARS=4000
LONG_QUERY_CHARS=500
MAX_ARTICLE_REFS=10
MAX_SUB_QUERIES=3
MAX_SUB_QUERIES_LONG=5
MAX_CONCURRENT_STREAMS=20
RATE_LIMIT_SESSION=10/minute
RATE_LIMIT_IP=30/minute
RATE_LIMIT_IP_DAILY=300/day
SESSIONS_PER_IP_DAILY=20
IP_HASH_SALT=change-me
