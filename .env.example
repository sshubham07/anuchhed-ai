# ---- App ----
ENV=dev                              # dev | staging | prod
SERVICE_NAME=samvidhan-api
APP_VERSION=dev                      # git sha in Docker builds
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                   # console | json
DEBUG_UI=true                        # adds route + scored chunks to SSE `done`; set false when public
SERVE_UI=true                        # serve the web UI at / (ADR-0013)
UI_DIR=ui
CORS_ORIGINS=http://localhost:8501   # comma-separated; only for a UI on another origin

# ---- Database ----
DB_HOST_PORT=5433                    # host port of the compose db (5432 is often taken)
POSTGRES_USER=samvidhan
POSTGRES_PASSWORD=                   # required; generate one: openssl rand -hex 16
POSTGRES_DB=samvidhan
DATABASE_URL=postgresql+asyncpg://samvidhan:<POSTGRES_PASSWORD>@localhost:5433/samvidhan   # same password as above
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_S=5
READINESS_TIMEOUT_S=2

# ---- LLM providers (secrets: never commit real values) ----
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Models (checked 2026-10-01 against each provider's model list; re-verify — lineups change) ----
ROUTER_MODEL=groq/qwen/qwen3.8-27b
ROUTER_FALLBACK_MODEL=gemini/gemini-3.5-flash-lite
ANSWER_MODEL=groq/openai/gpt-oss-120b
ANSWER_FALLBACK_MODEL=gemini/gemini-3.5-flash
ROUTER_MODEL_LONG=groq/openai/gpt-oss-120b
ANSWER_MODEL_LONG=gemini/gemini-3.5-flash
ANSWER_FALLBACK_MODEL_LONG=groq/openai/gpt-oss-120b
SUMMARY_MODEL=groq/qwen/qwen3.8-27b
JUDGE_MODEL=gemini/gemini-3.5-flash
JUDGE_FALLBACK_MODEL=groq/openai/gpt-oss-120b
# Hidden-reasoning budget per model (JSON). Thinking eats output tokens: keep it low.
MODEL_REASONING_EFFORT={"groq/qwen/qwen3.8-27b":"none","groq/openai/gpt-oss-120b":"low","groq/openai/gpt-oss-20b":"low","gemini/gemini-3.5-flash":"minimal"}
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
MODEL_DEVICE=auto                    # auto | cpu | mps | cuda

# ---- Daily request caps per model (budget guard; set from provider console) ----
DAILY_CAP_ROUTER_MODEL=1000         # Groq free tier: 1,000 req/day and 8,000 tokens/min per model
DAILY_CAP_ANSWER_MODEL=1000
DAILY_CAP_ROUTER_FALLBACK_MODEL=0    # 0 = no cap
DAILY_CAP_ANSWER_FALLBACK_MODEL=0
BUDGET_WARN_RATIO=0.8                # at this share of a cap, switch to the fallback model
BUDGET_CACHE_S=30                    # seconds a per-model usage count is reused before re-querying llm_calls

# ---- LLM params ----
ANSWER_TEMPERATURE=0.1
ANSWER_MAX_TOKENS=700
ANSWER_MAX_TOKENS_LONG=1500
ROUTER_MAX_TOKENS=300
ROUTER_TEMPERATURE=0
HYDE_MAX_TOKENS=200
LLM_TIMEOUT_S=20
LLM_TIMEOUT_LONG_S=45
LLM_MAX_RETRIES=1                    # retries per model on timeout/429/5xx, then the fallback model
LLM_RETRY_BACKOFF_S=0.5              # base of the jittered backoff between retries

# ---- Prompts ----
ROUTER_PROMPT_VERSION=router.v1
ANSWER_PROMPT_VERSION=answer.v1
SUMMARY_PROMPT_VERSION=summary.v1
HYDE_PROMPT_VERSION=hyde.v1
PROMPTS_DIR=prompts                  # versioned prompt files (relative to the working directory)

# ---- Ingestion ----
# Bump CHUNKER_VERSION whenever any CHUNK_* / EMBED_MAX_LENGTH value or chunking code changes:
# ingestion is keyed by (PDF sha256, CHUNKER_VERSION, EMBED_MODEL) and skips an existing key.
CHUNKER_VERSION=v1
EMBED_BATCH_SIZE=16
EMBED_MAX_LENGTH=1024               # tokens; longer chunk text is truncated by the embedder
INGEST_MIN_TEXT_PAGE_RATIO=0.9       # fail fast if fewer PDF pages have a text layer (scanned PDF)
CHUNK_MAX_TOKENS=800                 # an Article above this is split at clause boundaries
CHUNK_TARGET_MIN_TOKENS=300          # split pieces: lower bound
CHUNK_TARGET_MAX_TOKENS=700          # split pieces: upper bound
SCHEDULE7_ENTRIES_PER_CHUNK=10

# ---- Retrieval ----
DENSE_K=20
LEXICAL_K=20
RRF_K=60
RERANK_CANDIDATES=15
RERANK_MAX_LENGTH=512
FINAL_K=10
SUB_QUERY_K=3                        # multi_part: top chunks kept per sub-query before merging
MAX_CONTEXT_CHUNKS=12
MAX_CONTEXT_CHUNKS_LONG=15
MAX_CONTEXT_TOKENS=7000
MAX_CONTEXT_TOKENS_LONG=8000
LOW_CONFIDENCE_THRESHOLD=0.05        # sigmoid rerank score; tuned on dev (P3.8, retrieval spec §3.8)

# ---- Memory ----
ROUTER_HISTORY_MESSAGES=6
ANSWER_HISTORY_MESSAGES=2
SUMMARY_ENABLED=false
RAW_WINDOW=12
SUMMARY_BATCH=6
SESSION_TTL_DAYS=30
MAX_MESSAGES_PER_SESSION=200

# ---- Limits ----
MAX_MESSAGE_CHARS=4000
LONG_QUERY_CHARS=500
MAX_ARTICLE_REFS=10
MAX_SUB_QUERIES=3
MAX_SUB_QUERIES_LONG=5
MAX_CONCURRENT_STREAMS=20
RATE_LIMIT_SESSION=10/minute
RATE_LIMIT_IP=30/minute
RATE_LIMIT_IP_DAILY=300/day
SESSIONS_PER_IP_DAILY=20
IP_HASH_SALT=change-me            # required outside dev: a random secret
TRUSTED_PROXY_IPS=                # comma-separated peers allowed to send X-Forwarded-For (the UI)
